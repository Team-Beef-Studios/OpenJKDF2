<?xml version="1.0" encoding="utf-8"?>
<!-- OpenJKDF2 VR - Android VR Manifest (Meta Quest + Pico 4/Neo3) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.teambeefvr.jkdf2xr"
    android:versionCode="3"
    android:versionName="0.7.2"
    android:installLocation="auto">

    <!-- OpenGL ES 3.1 required for Quest VR -->
    <uses-feature android:glEsVersion="0x00030001" android:required="true"/>

    <!-- VR head tracking. NOT required: "true" declares the app VR-only, so the headset enters
         immersive mode at launch and the flat launcher activity never gets composited. The app
         still runs in VR - VRActivity carries the immersive categories and drives OpenXR. -->
    <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="false" />

    <!-- Touchscreen not required for VR -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- All files access for /sdcard/JKDF2XR game data -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Quest VR keyboard requires scene permission -->
    <uses-permission android:name="horizonos.permission.USE_SCENE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true"
        android:requestLegacyExternalStorage="true">

        <!-- Meta Quest VR configuration -->
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest|quest2|questpro|quest3"/>
        <!-- Off: this is the system loading splash (the spinning dots) drawn while a VR app
             starts. It sits in front of the flat launcher activity and hides the game chooser. -->
        <meta-data android:name="com.oculus.ossplash" android:value="false"/>
        <!-- Enable dual-core CPU mode for Quest 2/Pro/3 -->
        <meta-data android:name="com.oculus.dualcorecpuset" android:value="true"/>
        <!-- Allocate more CPU power (game is CPU-bound) -->
        <meta-data android:name="com.oculus.trade_cpu_for_gpu_amount" android:value="-1"/>

        <!-- Pico XR support (Pico 4, Pico 4 Ultra, Pico Neo3) -->
        <meta-data android:name="pvr.app.type" android:value="vr"/>
        <meta-data android:name="pvr.display.orientation" android:value="180"/>
        <!-- Enable controller tracking -->
        <meta-data android:name="pxr.controller" android:value="1"/>

        <!-- Samsung GearVR/Oculus Go support (legacy). "dual" rather than "vr_only" because the
             app now starts in a flat launcher activity before entering VR. -->
        <meta-data android:name="com.samsung.android.vr.application.mode" android:value="dual"/>

        <!-- Launcher activity that checks for storage permission -->
        <activity android:name=".LauncherActivity"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="screenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode"
            android:excludeFromRecents="false"
            android:exported="true">

            <!-- Flat panel activity, not immersive. com.oculus.intent.category.2D is the part
                 that matters: without it the shell places even a non-VR entry activity into an
                 immersive volumetric window and waits for OpenXR frames that never come, so the
                 chooser draws but is never displayed. Mirrors CitraVR's MainActivity. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.2D" />
                <category android:name="com.oculus.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Main VR activity (started by LauncherActivity after permission check). Carries the
             immersive markers; no LAUNCHER category, so this adds no second icon. -->
        <activity android:name=".VRActivity"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:launchMode="singleTask"
            android:process=":vr_process"
            android:screenOrientation="landscape"
            android:configChanges="screenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode"
            android:excludeFromRecents="false"
            android:exported="true">

            <!-- VIEW rather than MAIN, so this never resolves as a home-screen entry and adds no
                 second icon - the shell only builds icons from MAIN+LAUNCHER. Same shape as
                 CitraVR's VrActivity. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <!-- Mark as VR app for Quest launcher -->
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Mark as VR app for Pico launcher -->
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity>
    </application>
</manifest>
